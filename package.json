{
  "name": "spendiapp",
  "version": "2.64.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "node --stack-size=10000 ./node_modules/typescript/lib/tsc.js --noEmit",
    "export": "expo export --platform web && node scripts/patch-html.js",
    "deploy": "npm run export && vercel --prod",
    "reset-whats-new": "node scripts/reset-whats-new.js",
    "check-i18n": "node scripts/check-i18n.js"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/metro-runtime": "~55.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tabler/icons-react-native": "^3.44.0",
    "babel-preset-expo": "^55.0.13",
    "expo": "~55.0.27",
    "expo-clipboard": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.16",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-linear-gradient": "~55.0.15",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.16",
    "expo-router": "~55.0.16",
    "expo-system-ui": "~55.0.20",
    "firebase": "^12.11.0",
    "i18next": "^26.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.1",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
